        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"type\": \"DEBIT\",\n  \"amount\": 50.00,\n  \"currency\": \"BRL\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "transactions"]
        },
        "description": "Creates a debit transaction that removes funds from an account"
      },
      "response": []
    },
    {
      "name": "Create Debit Transaction - Insufficient Balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Transaction status is FAILED\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.transaction.status).to.eql(\"FAILED\");",
              "});",
              "",
              "pm.test(\"Balance remained unchanged\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.account.balance).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
