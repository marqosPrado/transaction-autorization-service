          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "transactions"]
        },
        "description": "Creates an initial credit transaction. Use Postman Runner to execute this multiple times with different values."
      },
      "response": []
